/**
 * __TOOL_NAME__ for Google Sheets: a menu item that opens __TOOL_NAME__ on the user's computer.
 *
 * Apps Script runs on Google's servers, so it can't reach the user's computer: "localhost" there is Google's own
 * machine. This script therefore never calls the local app. It shows a link; the user clicks it, and their own
 * browser opens __TOOL_NAME__. To use this sheet's data there, the user downloads it as .xlsx first.
 *
 * Install: in the sheet, Extensions > Apps Script, paste this file, save, then reload the sheet.
 */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('__TOOL_NAME__')
    .addItem('Open __TOOL_NAME__', 'openTool')
    .addToUi();
}

function openTool() {
  var url = 'http://localhost:__PORT__/';
  var html = HtmlService.createHtmlOutput(
    '<div style="font-family: Arial, sans-serif; font-size: 14px; line-height: 1.5">' +
      '<p>__TOOL_NAME__ runs on your computer. Start it, then open it here:</p>' +
      '<p><a href="' + url + '" target="_blank" rel="noopener">Open __TOOL_NAME__</a></p>' +
      '<p style="color: #555">To work on this sheet there, download it first: ' +
      'File &gt; Download &gt; Microsoft Excel (.xlsx).</p>' +
    '</div>'
  ).setWidth(380).setHeight(180);
  SpreadsheetApp.getUi().showModalDialog(html, '__TOOL_NAME__');
}
