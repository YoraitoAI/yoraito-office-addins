<?xml version="1.0" encoding="UTF-8"?>
<!-- Excel add-in manifest for a Yoraito tool. Office loads every URL here over HTTPS only (see docs/SIDELOADING.md):
     the tool serves excel/ at https://localhost:__ADDIN_PORT__/addins/excel/ with a certificate the computer trusts. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>__ADDIN_ID__</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Yoraito</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="__TOOL_NAME__"/>
  <Description DefaultValue="__TOOL_DESCRIPTION__"/>
  <IconUrl DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/YoraitoAI/__TOOL_ID__"/>
  <AppDomains>
    <AppDomain>https://localhost:__ADDIN_PORT__</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <!-- The ribbon button: a "Yoraito" group on the Home tab that opens the task pane. -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Yoraito.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="Yoraito.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>YoraitoTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/YoraitoAI/__TOOL_ID__"/>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:__ADDIN_PORT__/addins/excel/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="__TOOL_NAME__ is ready"/>
        <bt:String id="Group.Label" DefaultValue="Yoraito"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="__TOOL_NAME__"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open __TOOL_NAME__ from the Yoraito group on the Home tab."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="__TOOL_DESCRIPTION__"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
